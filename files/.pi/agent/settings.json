{
  "images": {
    "blockImages": false
  },
  "terminal": {
    "showImages": false
  },
  "hideThinkingBlock": false,
  "quietStartup": true,
  "theme": "rose-pine-moon-code",
  "steeringMode": "all",
  "followUpMode": "all",
  "collapseChangelog": true,
  "packages": [
    "npm:pi-web-access",
    "npm:@ryan_nookpi/pi-extension-codex-fast-mode",
    "git:github.com/algal/pi-openai-server-compaction",
    "npm:pi-antigravity",
    "npm:pi-claude-bridge",
    "git:github.com/camilojourney/pi-cursor-provider",
    "npm:pi-llama-cpp"
  ],
  "llamaServerUrl": "http://127.0.0.1:8080",
  "thinkingBudgets": {
    "minimal": 512,
    "low": 1024,
    "medium": 2048,
    "high": 4096,
    "xhigh": 8192
  },
  "lastChangelogVersion": "0.87.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "defaultProjectTrust": "always",
  "tuiMode": "regular",
  "outputPad": 1
}