# no-mistakes pipeline evidence should never be committed to this public repo
.no-mistakes/
.pipeline-state/
.worktrees/
graphify-out/

# macOS and tool caches
.DS_Store
**/.DS_Store
.cache/
**/.cache/

# Herdr runtime state (lives under files/.config/herdr via HM symlink)
files/.config/herdr/*.log
files/.config/herdr/*.sock
files/.config/herdr/**/*.log
files/.config/herdr/**/*.sock
files/.config/herdr/session.json
files/.config/herdr/release-notes.json
files/.config/herdr/sessions/
files/.config/herdr/**/sessions/

# Cursor launcher machine-local config. Keep the portable example tracked.
files/.config/cursor-launchers/config.sh
!files/.config/cursor-launchers/config.sh.example
