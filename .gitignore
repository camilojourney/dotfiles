# no-mistakes pipeline evidence should never be committed to this public repo
.no-mistakes/
# ...except the authored global config, symlinked to ~/.no-mistakes by Home Manager
!home/.no-mistakes/

# Ignore fetched upstream artifacts; tracked baseline files remain versioned.
/upstream/

# Task-local pilot dependencies; runtime state is always outside this repository.
/services/agent-platform/pilot/node_modules/

# Claude Code per-machine local settings
.claude/settings.local.json

# macOS metadata junk
.DS_Store

# OBS rewrites *.bak on every save. Stream keys are blanked on commit by the
# obs-keys filter (.gitattributes), not ignored.
home/.config/obs-studio/basic/**/*.bak

# Legacy runtime guard only; app state is relocated outside the checkout.
# See docs/CONFIGURATION.md. These files must not live here after migration.
home/.config/herdr/*.log
home/.config/herdr/*.sock
home/.config/herdr/*.sock.agent
home/.config/herdr/session-snapshots/
home/.config/herdr/session.json
home/.config/herdr/.plugins.lock
home/.config/herdr/release-notes.json
home/.config/herdr/sessions/
home/.config/herdr/bin/
