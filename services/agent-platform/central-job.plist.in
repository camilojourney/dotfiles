<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- [impl->req~agent-platform.central-terminal~1] -->
<plist version="1.0"><dict>
  <key>Label</key><string>dev.agent-platform.durable</string>
  <key>ProgramArguments</key><array>
    <string>@LAUNCHER@</string><string>@PYTHON@</string><string>@CODE@/require-ssd.py</string><string>@CONFIG@</string><string>--</string>
    <string>/usr/bin/env</string><string>SCREENDIR=@ROOT@/state/pi/terminal</string><string>STY=</string><string>TERM=xterm-256color</string>
    <string>/usr/bin/screen</string><string>-D</string><string>-m</string><string>-c</string><string>/dev/null</string>
    <string>-h</string><string>200</string><string>-S</string><string>agent-platform</string>
    <string>@NODE@</string><string>@CODE@/central.mjs</string><string>@ROOT@/state/pi/central</string><string>serve</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ExitTimeOut</key><integer>10</integer>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>/dev/null</string>
</dict></plist>
