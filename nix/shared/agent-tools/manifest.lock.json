{
  "policy": {
    "update": "Pinned versions are reconciled on every rebuild. Bump pins in this manifest explicitly; rebuild never floats to unpinned latest. Run scripts/agent-tools/check-pins.sh periodically to report registry drift; it never edits or installs anything. Exception: @earendil-works/pi-coding-agent is intentionally pinned to \"latest\" (not a version) on both hosts, by explicit request, trading reproducibility for always-current Pi.",
    "npm": "Global npm CLIs install via brew node npm with --ignore-scripts. The global npm package itself is never managed here so brew node owns npm.",
    "pipx": "Isolated Python CLIs install via brew pipx with ==version pins.",
    "external": "Release archives download from official GitHub releases with sha256 verification (see scripts/agent-tools/install-external.sh).",
    "reproducibility": "npm/pipx pins are auditable in this file. External binaries add content-addressed sha256 per platform. Bumping a pin is an intentional manifest edit; check-pins.sh is advisory only and rebuilds remain pinned except for entries explicitly set to latest."
  },
  "npm": [
  { "name": "@earendil-works/pi-coding-agent", "version": "latest" },
  { "name": "acpx", "version": "0.19.3" },
  { "name": "chrome-devtools-axi", "version": "0.1.35" },
  { "name": "gh-axi", "version": "0.1.35" },
  { "name": "gnhf", "version": "0.1.50" },
  { "name": "lavish-axi", "version": "0.1.79" },
  { "name": "pnpm", "version": "12.6.0" },
  { "name": "quota-axi", "version": "0.1.55" },
  { "name": "tasks-axi", "version": "0.2.6" }
  ],
  "profiles": {
    "camilo-remote": {
      "npm": ["@earendil-works/pi-coding-agent", "acpx", "chrome-devtools-axi", "gh-axi", "gnhf", "lavish-axi", "pnpm", "quota-axi", "tasks-axi"],
      "external": ["no-mistakes", "treehouse"]
    },
    "camilo": {
      "npm": ["@earendil-works/pi-coding-agent", "acpx", "chrome-devtools-axi", "gh-axi", "gnhf", "lavish-axi", "pnpm", "quota-axi", "tasks-axi"],
      "external": ["no-mistakes", "treehouse"]
    }
  },
  "pipx": {
    "shared": [
      { "name": "graphifyy", "version": "0.9.69" }
    ],
    "camilo": [
      { "name": "mlx-lm", "version": "0.31.3" },
      { "name": "mlx-optiq", "version": "0.5.13" }
    ]
  },
  "external": {
    "no-mistakes": {
      "version": "1.79.0",
      "repo": "kunchenguid/no-mistakes",
      "installSubdir": ".no-mistakes/bin",
      "binary": "no-mistakes",
      "archivePattern": "no-mistakes-v{version}-{os}-{arch}.tar.gz",
      "sha256": {
        "darwin-arm64": "80c2f4b9b3d01cb5d60ca294226b41d7331408e6e5cf0400a576cf3ec25166d7",
        "darwin-amd64": "97a7fa50be1ec0e07e4b00d38b4fc83b12dc961cbe1a4628a13a5b620662069b"
      }
    },
    "treehouse": {
      "version": "3.1.0",
      "repo": "kunchenguid/treehouse",
      "installSubdir": ".local/bin",
      "binary": "treehouse",
      "archivePattern": "treehouse-v{version}-{os}-{arch}.tar.gz",
      "sha256": {
        "darwin-arm64": "e78f52f078d90ffa8589da164fc87306020c5524776273ad040af04127dd91df",
        "darwin-amd64": "95a6f5cf582f767a8b102a749a53ea397bf28d20df10467c367927f26073e131"
      }
    }
  },
  "setupHooks": {
    "npm": [
      {"name": "gh-axi"},
      {"name": "lavish-axi"},
      {"name": "chrome-devtools-axi"},
      {"name": "tasks-axi"}
    ],
    "graphify": {
      "command": "graphify",
      "platforms": ["codex", "pi", "opencode"]
    }
  },
  "verify": {
    "bins": ["pi", "acpx", "gh-axi", "pnpm", "quota-axi", "tasks-axi", "graphify", "tmux"],
    "hostBins": {
      "camilo": ["chrome-devtools-axi", "gnhf", "lavish-axi", "no-mistakes", "treehouse", "mlx_lm", "optiq"],
      "camilo-remote": ["chrome-devtools-axi", "gnhf", "lavish-axi", "no-mistakes", "treehouse"]
    }
  }
}
